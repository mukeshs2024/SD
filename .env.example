# Digital Wallet Platform Configuration
# Server
FLASK_ENV=development
PORT=5000
DEBUG=True

# Database Configuration
# Default: SQLite (no setup required)
# For PostgreSQL: postgresql+psycopg2://username:password@localhost:5432/digital_wallet
DATABASE_URL=sqlite:///digital_wallet.db

# Redis Caching (Optional - automatically falls back to in-memory/direct DB if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=True

# Fraud Detection Thresholds
MAX_SINGLE_TRANSFER_LIMIT=100000.0
HIGH_VALUE_ALERT_THRESHOLD=25000.0
